        <script>
            $(function () {
                $("#header").load("header.html");
                $("#footer").load("footer.html");
            });
        </script>
        <script type="text/javascript">
            $('#timepicker1').timepicker();
        </script>
        <script>
            $("#sendOtpBtn1").click(function () {
                $("#otp-box").css({ "display": "block" });
                $("#sendOtpBtn1").text('Resend OTP');
            });
        </script>
        <script>
            $("#sendOtpBtn").click(function () {
                $("#otp-box").css({ "display": "block" });
                $("#sendOtpBtn").text('Resend OTP');
            });
        </script>
        <script type="text/javascript">
            var otp = "";
            jQuery(function () {
                $('#btnSubmit').click(function (e) {
                    var name = $("#name1").val();
                    var companyname = $("#CompanyName").val();
                    var email = $("#email1").val();
                    var phone = $("#mobile1").val();
                    var checkmsg = "hellomessage";
                    otp = $("#otp").val();
                    // var kios = "Online Examination";
                    var message = $("#message1").val();
                    var enqry = "EnquiryMessage";
                    if (name == "" || phone == "" || email == "" || companyname == "" || otp == "") {
                        $("#btnSubmit").attr("disabled", "disabled");
                    }
                    else {
                        $("#btnSubmit").prop('disabled', false);
                        var idd = $("#otp").val();
                        var checkotp = "hello";
                        var ids = $.trim(idd);
                        var mobile = $("#mobile1").val();
                        $.ajax({
                            type: "post",
                            url: "Enquire.ashx",
                            data: {
                                "otp": idd,
                                "checkotp": checkotp,
                                "mobile": mobile
                            },
                            datatype: 'json',
                            success: function (data) {

                                if (data == "Fail") {
                                    alert("Enter Correct otp")
                                }
                                if (data == "SUCCESS") {
                                    jQuery.ajax({
                                        type: "GET",
                                        url: "Enquire.ashx",
                                        data: { 'name': name, 'phoneNo': phone, 'email': email, 'companyName': companyname, 'message': message, 'msg': checkmsg, 'enqmsg': enqry },
                                        success: function (data) {
                                            if (data != null) {
                                                window.location.href = "thankyou.html";

                                                $("#name1").val(null);
                                                $("#CompanyName").val(null);
                                                $("#email1").val(null);
                                                $("#mobile1").val(null);
                                                $("#message1").val(null);
                                                $("#otp").val(null);
                                            }
                                        }
                                    });
                                }
                            }
                        });
                    }
                });
            });
        </script>
        <script>
            $(document).ready(function (e) {
                var mobile = $("#mobile1").val();
                var email = $("#email1").val();
                var cmpnyname = $("#CompanyName").val();
                var name = $("#name1").val();
                if (mobile == "" || email == "" || cmpnyname == "" || name == "") {
                    $("#sendOtpBtn1").attr("disabled", "disabled");
                    $("#sendOtpBtn1").prop('disabled', true);
                }
                else { $("#sendOtpBtn1").prop('disabled', false); }
            })
        </script>
        <script>
            var enableSubmit = function (ele) {
                $(ele).removeAttr("disabled");
            }
            $("#sendOtpBtn1").click(function () {
                var that = this;
                $(this).attr("disabled", true);
                setTimeout(function () { enableSubmit(that) }, 100000);
            });
        </script>
        <script>
            $("input[type=text]").keyup(function (e) {
                var mobile = $("#mobile1").val();
                var lengthh = mobile.length;
                var email = $("#email1").val();
                var cntry = $("#CompanyName").val();
                var name = $("#name1").val();
                if (mobile == "" || email == "" || cntry == "" || name == "" || lengthh < 10) {
                    $("#sendOtpBtn1").attr("disabled", "disabled");
                    $("#sendOtpBtn1").prop('disabled', true);
                    e.preventDefault();
                }
                else {
                    $("#sendOtpBtn1").prop('disabled', false);
                }
            })
        </script>
        <script type="text/javascript">
            $("#otp").change(function () {
                var otp = $("#otp").val();
                if (otp == "") {
                    $("#btnSubmit").attr("disabled", "disabled");
                }
                else {
                    $("#btnSubmit").prop('disabled', false);
                }
            });
            $('#sendOtpBtn1').click(function () {
                var otp = $("#otp").val();
                var mobile = $("#mobile1").val();
                var email = $("#email1").val();
                var message1 = $("#message1").val();
                jQuery.ajax({
                    type: "GET",
                    url: "Enquire.ashx",
                    data: { 'otp': otp, 'phone': mobile, 'email': email },
                    success: function (data) {
                        debugger;
                        if (otp == "") {
                            $("#btnSubmit").attr("disabled", "disabled");
                            alert("Check Mobile and Email for OTP");
                            e.preventDefault();
                        }
                    }

                });
            });
        </script>
        <script type="text/javascript">
            $('#sendOtpBtn1').click(function () {
                jQuery.ajax({
                    type: "GET",
                    url: "Enquire.ashx",
                    data: {},
                    success: function (data) {
                    }
                });
            });
        </script>
        <!--Digits validation-->
        <script>
            $(document).ready(function () {
                $("#mobile1,#otp").keypress(function (e) {
                    if (e.which != 8 && e.which != 0 && (e.which < 48 || e.which > 57)) {
                        return false;
                    }
                });
            })
        </script>
        <!--Name validation-->
        <script>
            $(function () {
                $("#name1").keydown(function (e) {
                    if (e.shiftKey || e.ctrlKey || e.altKey) {
                    } else {
                        var key = e.keyCode;
                        if (!((key == 8) || (key == 32) || (key == 46) || (key >= 35 && key <= 40) || (key >= 65 && key <= 90))) {
                            e.preventDefault();
                        }
                    }
                });
            });
        </script>
        <!--Email validation-->
        <script>
            $("#email1").keyup(function (e) {
                var sEmail = $('#email1').val();
                if (validateEmail(sEmail)) { $("#emailreq").hide(); }
                else {
                    $("#emailreq").html("<b>Please choose correct email!</b>");
                    $("#emailreq").show();
                    $("#sendOtpBtn1").prop('disabled', true);
                }
            });
            function validateEmail(sEmail) {
                var filter = /^[\w\-\.\+]+\@[a-zA-Z0-9\.\-]+\.[a-zA-z0-9]{2,4}$/;
                if (filter.test(sEmail)) {
                    return true;
                    $("#emailreq").hide();
                    $("#emailreq2").hide();
                }
                else { return false; }
            }
        </script>
        <!-- 🟦 XIPHIAS n8n Chat Widget -->
        <link rel="stylesheet" href="css/chat-theme.css">

        <script>
            document.addEventListener("DOMContentLoaded", function () {
                // --- Create Floating Chat Button ---
                const chatBtn = document.createElement("button");
                chatBtn.id = "openChatBtn";
                chatBtn.innerHTML = "💬";
                Object.assign(chatBtn.style, {
                    position: "fixed",
                    bottom: "20px",
                    right: "20px",
                    backgroundColor: "#0F2D81",
                    color: "white",
                    border: "none",
                    borderRadius: "50%",
                    width: "60px",
                    height: "60px",
                    fontSize: "26px",
                    cursor: "pointer",
                    boxShadow: "0 4px 10px rgba(0,0,0,0.3)",
                    zIndex: "9999"
                });
                document.body.appendChild(chatBtn);

                // --- Create Chat Popup ---
                const chatPopup = document.createElement("div");
                chatPopup.id = "chatPopup";
                Object.assign(chatPopup.style, {
                    display: "none",
                    position: "fixed",
                    bottom: "90px",
                    right: "20px",
                    width: "420px",
                    height: "600px",
                    background: "#FFFFFF",
                    borderRadius: "14px",
                    boxShadow: "0 18px 40px rgba(15,45,129,0.25)",
                    zIndex: "10000",
                    overflow: "hidden"
                });

                // --- Load the n8n Chat Webhook ---
                const chatFrame = document.createElement("iframe");
                chatFrame.src = "https://n8n.srv957076.hstgr.cloud/webhook/4091fa09-fb9a-4039-9411-7104d213f601/chat";
                chatFrame.width = "100%";
                chatFrame.height = "100%";
                chatFrame.frameBorder = "0";
                chatFrame.style.borderRadius = "14px";

                chatPopup.appendChild(chatFrame);
                document.body.appendChild(chatPopup);

                // --- Toggle Chat Window ---
                chatBtn.addEventListener("click", () => {
                    chatPopup.style.display = chatPopup.style.display === "none" ? "block" : "none";
                });
            });
        </script>

        <script type="text/javascript">
