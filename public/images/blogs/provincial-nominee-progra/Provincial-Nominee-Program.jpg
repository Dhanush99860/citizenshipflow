<body class="w1170 headerstyle1" onLoad="DrawCaptcha();">
    <div id="marine-content-wrapper">
        <div class="ccm-page page-template-home" id="header"></div>
        <span id="js-back-to-menu"><i class="fa fa-chevron-up" aria-hidden="true"></i></span>
        <section class="container welcome_row_spacer" style="padding-top: 150px;">
            <div class="row">
                <div class="col-xs-12 text-center">
                    <img src="images/error_sad_simily.jpg" alt="" />
                    <h2 style="margin-bottom: 0; font-size: 62px;">404</h2>
                    <h4 style="margin-bottom: 5px; color: #a5a5a5;">Page not found</h4>
                    <p class="text-center">The page you looking for doesn't exit or another error occurred <a href="index.html" style="color: #dbb72d;">Go back</a> to choose a new direction.</p>
                </div>
